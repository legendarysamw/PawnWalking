# Postgres connection string used by packages/db (Prisma).
# Matches docker-compose.yml out of the box - `docker compose up -d` and this
# just works with no edits needed.
DATABASE_URL="postgresql://pawnwalking:pawnwalking@localhost:5432/pawnwalking"

# Session cookie signing secret (any long random string - fine to leave this
# placeholder for local dev, just don't reuse it in production)
SESSION_SECRET="local-dev-session-secret-change-me"

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys).
# The app runs fine without these - wallet top-up / subscribe buttons will
# just show an error until they're filled in.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID for the walker monthly subscription plan (Stripe Billing)
STRIPE_WALKER_SUBSCRIPTION_PRICE_ID="price_..."

# Base URL of the web app (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
